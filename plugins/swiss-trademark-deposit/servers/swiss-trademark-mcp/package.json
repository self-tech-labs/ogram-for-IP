{
  "name": "swiss-trademark-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Read-only MCP server for Swiss trademark deposit corpora.",
  "bin": {
    "swiss-trademark-nice-headings": "./dist/nice-headings.js",
    "swiss-trademark-wdl": "./dist/wdl.js",
    "swiss-trademark-swissreg-corpus": "./dist/swissreg-corpus.js",
    "swiss-trademark-taf-decisions": "./dist/taf-decisions.js"
  },
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "ingest:check": "node scripts/check-ingestion.mjs",
    "build": "node scripts/build.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node dist/smoke.js",
    "plugin:smoke": "node ../../scripts/check-plugin.mjs",
    "plugin:package": "node ../../scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22 <26",
    "npm": ">=10"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "better-sqlite3@13.0.2": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.0"
    }
  }
}
