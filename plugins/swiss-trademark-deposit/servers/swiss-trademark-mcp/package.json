{
  "name": "swiss-trademark-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Read-only MCP server for Swiss trademark deposit corpora.",
  "bin": {
    "swiss-trademark-mcp": "./dist/index.js",
    "swiss-trademark-nice-headings": "./dist/nice-headings.js",
    "swiss-trademark-wdl": "./dist/wdl.js",
    "swiss-trademark-swissreg-corpus": "./dist/swissreg-corpus.js",
    "swiss-trademark-taf-decisions": "./dist/taf-decisions.js"
  },
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "plugin:smoke": "node ../../scripts/check-plugin.mjs",
    "plugin:package": "node ../../scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
